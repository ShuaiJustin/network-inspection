{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "网络设备巡检",
  "version": "0.1.35",
  "identifier": "com.local.networkinspection",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "网络设备巡检",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#f4f6f8",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/inspection-api"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRUVEMjgyODg2OTFCOUYKUldTZkcybUlndEx1RUZnU1ZHenUwWEtWcWhIb2kwaGtqWnNpSElJbk5hODdla2pKck8yeWtXSUcK",
      "endpoints": [
        "https://github.com/ShuaiJustin/network-inspection/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
